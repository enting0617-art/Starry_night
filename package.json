{
  "name": "portable-ollama-chat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"node --watch server/index.js\"",
    "build": "vite build",
    "start": "node --no-warnings server/index.js",
    "check": "eslint .",
    "test": "node --test tests/*.test.js",
    "doctor": "node scripts/doctor.js",
    "emojis:import": "node --no-warnings scripts/import-emojis.js"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@vitejs/plugin-react": "latest",
    "express": "latest",
    "ipaddr.js": "^2.5.0",
    "jsdom": "^30.1.3",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "latest",
    "remark-gfm": "latest",
    "robots-parser": "^3.0.1",
    "vite": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "concurrently": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest"
  }
}
